---
// P5.6 · D§1 D6: the ESV app shell. The Worker serves it for /esv/{book}/{chapter}[/{verses}] when ESV is
// enabled; the passage loads client-side (scripts/esv.ts). This file must never contain ESV text.
import Base from "../../layouts/Base.astro";
import { SITE_NAME } from "@tolle/core";
---
<Base title={`English Standard Version — ${SITE_NAME}`} canonical="/esv/" noindex>
  <div id="esv-root" class="esv-root" aria-busy="true">
    <h1 class="ch" tabindex="-1">English Standard Version</h1>
    <div class="esv-skel" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </div>
</Base>
<style is:global>
  .esv-skel { display: none; }
  .esv-wait .esv-skel { display: block; }
  .esv-skel span { display: block; block-size: 1em; margin-block: .9em; border-radius: 4px; background: var(--hover); }
  .esv-skel span:nth-child(3n) { inline-size: 70%; }
  .esv-parts { display: flex; flex-wrap: wrap; gap: 8px; margin-block: 1.5em; }
</style>
