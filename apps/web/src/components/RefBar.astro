---
// D§3.4 reference bar (SPEC P1–P7) with prev/next beside it (P6). Labels are filled by refbar.ts.
---
<a id="bar-prev" class="btn nav-btn" title="Previous chapter (←)" aria-label="Previous chapter" aria-disabled="true">←</a>
<div class="refbar">
  <input id="refbar" type="text" role="combobox" aria-label="Go to reference or search" aria-expanded="false"
    aria-controls="refbar-list" aria-autocomplete="list" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" />
  <span id="refbar-hint" class="refbar-hint" aria-hidden="true"></span>
  <ul id="refbar-list" role="listbox" aria-label="Suggestions" hidden></ul>
  <p id="refbar-msg" class="refbar-msg" role="status"></p>
</div>
<a id="bar-next" class="btn nav-btn" title="Next chapter (→)" aria-label="Next chapter" aria-disabled="true">→</a>
<style>
  .refbar { position: relative; flex: 0 1 auto; min-width: 0; }
  input {
    inline-size: 360px; max-inline-size: 60vw; block-size: 32px; padding: 0 12px;
    font: inherit; font-size: 14px; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 8px;
    transition: inline-size var(--t-open) var(--ease), border-color var(--t-hover) var(--ease);
  }
  input:hover { border-color: var(--text-3); }
  input:focus { inline-size: 520px; }
  /* 320 px reflow (WCAG 1.4.10): the bar shrinks the field instead of overflowing. */
  input { max-inline-size: 100%; box-sizing: border-box; }
  .refbar-hint { position: absolute; inset-inline-start: 13px; top: 0; line-height: 32px; font-size: 14px; color: var(--text-2); pointer-events: none; white-space: pre; }
  ul {
    position: absolute; top: calc(100% + 4px); inset-inline: 0; margin: 0; padding: 4px; list-style: none; z-index: 20;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px; font-size: 14px;
  }
  li { padding: 6px 10px; border-radius: 6px; cursor: pointer; }
  li[aria-selected="true"], li:hover { background: var(--hover); }
  .refbar-msg { position: absolute; top: calc(100% + 4px); margin: 0; font-size: 13px; color: var(--text-2); white-space: nowrap; }
  .refbar-msg:empty { display: none; }
  .refbar-msg button { background: none; border: 0; padding: 0; color: var(--text); text-decoration: underline; cursor: pointer; font: inherit; }
  .nav-btn { text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { input { transition: none; } }
</style>
