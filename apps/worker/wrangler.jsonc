// D§2: Static Assets serve the built site; the Worker sees only unmatched paths and /api/*
// (P0.12 spike, docs/spikes/assets-routing.md). Production deploys are manual (deploy.yml).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tolle",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
